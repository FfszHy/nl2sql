# Copy this file to .env. Never commit your .env or data/ directory.
# These endpoints and payload defaults use the DashScope native API.
LLM_API_KEY=
LLM_API_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation
LLM_MODEL=qwen-plus
LLM_AUTH_HEADER=Authorization
LLM_AUTH_SCHEME=Bearer
LLM_EXTRA_HEADERS_JSON={}
LLM_PAYLOAD_MODEL_PATH=model
LLM_PAYLOAD_MESSAGES_PATH=input.messages
LLM_PAYLOAD_EXTRA_JSON={"parameters":{"result_format":"message"}}
LLM_RESPONSE_CONTENT_PATHS=output.choices.0.message.content,output.text
LLM_TIMEOUT_SECONDS=120
# Total SQL generations, including the first candidate; clamped to 1..3.
# Total SQL candidates, including the first attempt; range 1-10.
SQL_GENERATION_MAX_ATTEMPTS=5
# Persist query diagnostics as bounded JSONL; empty QUERY_AUDIT_PATH disables files.
# Contains questions, SQL and error details, never result rows or datasource credentials.
QUERY_AUDIT_PATH=data/query-audit.jsonl
QUERY_AUDIT_MAX_BYTES=1048576
QUERY_AUDIT_BACKUP_COUNT=3

# If empty, the embedding key falls back to DASHSCOPE_API_KEY or LLM_API_KEY.
EMBEDDING_API_KEY=
EMBEDDING_API_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=60
SEMANTIC_RETRIEVAL_ENABLED=true
SEMANTIC_TOP_K=3
SEMANTIC_SCORE_THRESHOLD=0.55

DATASOURCE_SQLITE_PATH=data/app_state.sqlite3
# Generate a unique value before registering a datasource; keep it stable.
# Current credential storage uses reversible obfuscation, not secure encryption.
DATASOURCE_SECRET_KEY=replace-with-a-random-local-secret
SCHEMA_CACHE_TTL_SECONDS=600
PG_SCHEMA=public
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
